{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "typecheck": "tsc --noEmit",
    "validate:env": "node scripts/check-env.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "recovery:check": "node scripts/recovery-check.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/integrations/supabase/types.generated.ts",
    "db:deploy": "powershell -ExecutionPolicy Bypass -File scripts/db-push.ps1",
    "db:baseline": "powershell -ExecutionPolicy Bypass -File scripts/db-baseline.ps1",
    "db:verify": "node scripts/verify-platform-db.mjs",
    "db:audit": "node scripts/schema-sync-audit.mjs",
    "db:isolation-test": "node scripts/tenant-isolation-test.mjs",
    "storage:audit": "node scripts/storage-audit.mjs",
    "storage:isolation-test": "node scripts/storage-isolation-test.mjs",
    "health:monitor": "node scripts/health-monitor-check.mjs",
    "load:test": "node scripts/load-test.mjs",
    "load:seed": "supabase db query --linked -f scripts/seed-load-test-store.sql",
    "db:check": "node scripts/platform-check.mjs",
    "db:bundle": "node scripts/bundle-platform-migrations.mjs",
    "functions:deploy-redeem": "supabase functions deploy redeem-access-code --no-verify-jwt",
    "functions:deploy-meta": "supabase functions deploy meta-conversions --no-verify-jwt",
    "functions:deploy-security": "supabase functions deploy redeem-access-code --no-verify-jwt && supabase functions deploy meta-conversions --no-verify-jwt",
    "functions:deploy-storefront": "supabase functions deploy get-store-products --no-verify-jwt"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^16.3.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "happy-dom": "^16.7.3",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^3.0.5"
  }
}
