# Edge Function secrets — set with: supabase secrets set KEY=value
# NEVER commit real values. NEVER expose service role key in the frontend.

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
STRIPE_WEBHOOK_SECRET=

# Auto-injected by Supabase runtime (do not set manually in production dashboard):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
