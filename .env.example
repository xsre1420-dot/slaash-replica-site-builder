# =============================================================================
# Frontend (Vite) — safe to expose in browser bundle (anon key only)
# Copy to .env for local dev. Never commit .env
# =============================================================================

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Use publishable/anon key from Dashboard → Project Settings → API
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
# Legacy alias (also supported): VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PROJECT_ID="your-project-id"

# development | staging | production
VITE_APP_ENV="development"

# Observability (optional) — webhook receives JSON batches of logs/metrics/alerts
# Disabled in production by default; set VITE_OBSERVABILITY_CLIENT_ENABLED=true to opt in.
# Prefer server-side log shipping — never embed secret webhook URLs in public bundles.
# VITE_OBSERVABILITY_WEBHOOK_URL="https://hooks.slack.com/services/..."
# VITE_OBSERVABILITY_CLIENT_ENABLED="false"
# VITE_OBSERVABILITY_SAMPLE_RATE=0.25

# Sales contact (subscription expired page + optional notifications)
# VITE_SALES_WHATSAPP="9647700000000"
# VITE_FAILOVER_SUPABASE_URL="https://failover-project.supabase.co"
# VITE_FAILOVER_SUPABASE_PUBLISHABLE_KEY="failover-anon-key"
#
# Scale (1000+ concurrent storefront users):
# VITE_SUPABASE_POOLER_URL="https://aws-0-eu-central-1.pooler.supabase.com"
# VITE_STOREFRONT_EDGE_URL="https://your-project-id.supabase.co/functions/v1/get-store-products"
# VITE_STOREFRONT_EDGE_ENABLED="true"
# VITE_CDN_BASE_URL="https://cdn.yourdomain.com"
# Read replica PostgREST (Supabase read replica URL) — offloads analytics/storefront reads
# VITE_SUPABASE_READ_REPLICA_URL="https://your-project-id.supabase.co"
# Shared L2 cache (Upstash Redis REST) — cross-tab / cross-instance coherence
# VITE_KV_REST_URL="https://your-redis.upstash.io"
# VITE_KV_REST_TOKEN="your-upstash-token"

# Server-side only (scripts/db:verify, CI) — NEVER expose in frontend bundle
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# Docker Compose (optional)
# =============================================================================
# APP_PORT=8080

# =============================================================================
# Supabase Edge Functions — set via Supabase Dashboard or CLI (NEVER in frontend)
#   supabase secrets set ENVIRONMENT=production
#   supabase secrets set ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#
# GitHub Actions (repository secrets):
#   SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD
#   ALLOWED_ORIGINS, STRIPE_WEBHOOK_SECRET
# =============================================================================
