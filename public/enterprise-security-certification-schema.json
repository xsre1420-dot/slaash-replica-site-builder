{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enterprise Security Certification Schema",
  "version": 93,
  "phases": ["owasp_top_10", "penetration_review", "dependency_audit", "abuse_protection"],
  "owaspCategories": [
    "A01 Broken Access Control",
    "A02 Cryptographic Failures",
    "A03 Injection",
    "A04 Insecure Design",
    "A05 Security Misconfiguration",
    "A06 Vulnerable Components",
    "A07 Authentication Failures",
    "A08 Software Integrity",
    "A09 Logging & Monitoring",
    "A10 SSRF"
  ],
  "penetrationSurfaces": [
    "authentication", "authorization", "checkout", "orders", "inventory",
    "payments", "admin_dashboard", "apis", "edge_functions", "storage", "realtime"
  ],
  "wafHeaders": {
    "requestId": "X-Request-Id",
    "clientIp": "X-Forwarded-For",
    "botScore": "X-Bot-Score",
    "rateLimitRemaining": "X-RateLimit-Remaining",
    "rateLimitReset": "X-RateLimit-Reset",
    "geoCountry": "X-Geo-Country",
    "wafAction": "X-WAF-Action"
  },
  "targetScores": {
    "owaspCompliance": 95,
    "applicationSecurity": 95,
    "infrastructureSecurity": 95,
    "dependencySecurity": 95,
    "operationalSecurity": 95,
    "productionSecurity": 95,
    "overallEnterpriseSecurity": 95
  }
}
